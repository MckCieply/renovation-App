# Frontend: Angular build served by Caddy (also proxies /api to the backend)
FROM node:20-alpine AS build
WORKDIR /app
COPY src/main/angular/package.json src/main/angular/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY src/main/angular/ .
RUN npx ng build --configuration production

FROM caddy:2-alpine
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/dist/angular/browser /srv
